# Database connection string.
# PostgreSQL: postgresql://user:password@host:port/database
# Local SQLite (no server required): sqlite:///./handyhire.db
DATABASE_URL=sqlite:///./handyhire.db

# JWT signing secret. MUST be a long, random, secret value in production.
SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated frontend origins allowed to call the API in production.
# Example: https://handyhire.vercel.app,https://www.handyhire.example
CORS_ORIGINS=
