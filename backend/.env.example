# HandyHire backend configuration template
# Copy to .env and adjust values for your environment.

# Runtime environment. Use production on Railway.
APP_ENV=development

# Database connection string.
# Neon PostgreSQL example: postgresql://user:password@host/database?sslmode=require
# Local SQLite (no server required): sqlite:///./handyhire.db
DATABASE_URL=sqlite:///./handyhire.db

# JWT signing secret. MUST be a long, random, secret value in production.
SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated frontend origins allowed to call the API.
# Add the final Vercel URL in Railway, for example:
# ALLOWED_ORIGINS=https://handyhire.vercel.app
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
